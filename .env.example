# --- WhatsApp provider ---
# "meta" (Meta Cloud API webhooks, default) or "greenapi" (Green API webhooks)
# WHATSAPP_PROVIDER=meta

# --- OXS Management API (https://api.oxs.co.il/api/external/v1) ---
# General module key — READ-ONLY (buildings + tenants)
OXS_GENERAL_API_KEY=
# Service Calls module key — FULL CONTROL (create service calls)
OXS_SERVICE_CALLS_API_KEY=
# OXS_BASE_URL=https://api.oxs.co.il/api/external/v1

# --- Meta WhatsApp Cloud API ---
# Any string you choose; type the same value in the Meta App dashboard when
# subscribing the webhook (Webhooks > Callback URL > Verify token).
META_VERIFY_TOKEN=
# Meta App secret (App settings > Basic). Optional but strongly recommended —
# when set, webhook POSTs are verified against X-Hub-Signature-256.
META_APP_SECRET=

# --- Green API (only when WHATSAPP_PROVIDER=greenapi) ---
# Naming follows the WhatsappToOsx setup: GREENAPI_API_KEY holds the NUMERIC
# idInstance, GREENAPI_INSTANCE_ID holds the long apiTokenInstance.
GREENAPI_API_KEY=
GREENAPI_INSTANCE_ID=
# Shared secret for inbound webhooks: set the SAME value here and in the Green
# API instance's webhookUrlToken setting. Without it webhooks are ACKed but
# ignored (fail closed).
GREENAPI_WEBHOOK_TOKEN=

# --- Optional tuning ---
# OXS_RATE_LIMIT_PER_MINUTE=55
# CACHE_TTL_SECONDS=600
# LOG_LEVEL=INFO
